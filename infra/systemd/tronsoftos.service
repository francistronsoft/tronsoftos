[Unit]
Description=TronSoftOS host service
After=network-online.target firebird.service
Wants=network-online.target

[Service]
Type=simple
User=tronsoftos
Group=tronsoftos
WorkingDirectory=/opt/tronsoftos
EnvironmentFile=-/etc/tronsoftos/tronsoftos.env
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=false
PermissionsStartOnly=true
ExecStartPre=/bin/mkdir -p /opt/tronsoftos/state /opt/tronsoftos/logs /opt/tronsoftos/config /opt/tronsoftos/config/rclone
ExecStartPre=/bin/chown -R tronsoftos:tronsoftos /opt/tronsoftos/state /opt/tronsoftos/logs /opt/tronsoftos/config
ExecStartPre=/bin/chmod 700 /opt/tronsoftos/state
ExecStartPre=/bin/chmod 750 /opt/tronsoftos/config
ExecStartPre=/bin/chmod 700 /opt/tronsoftos/config/rclone
ExecStartPre=/bin/sh -c '[ ! -f /opt/tronsoftos/config/rclone/rclone.conf ] || chown tronsoftos:tronsoftos /opt/tronsoftos/config/rclone/rclone.conf'
ExecStartPre=/bin/sh -c '[ ! -f /opt/tronsoftos/config/rclone/rclone.conf ] || chmod 600 /opt/tronsoftos/config/rclone/rclone.conf'
ExecStart=/usr/bin/node /opt/tronsoftos/backend/src/server.mjs
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
