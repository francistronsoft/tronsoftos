#!/usr/bin/env bash
set -euo pipefail

action="${1:-}"

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

fail() {
  local message="$1"
  printf '{"ok":false,"error":"%s"}\n' "$(json_escape "$message")"
  exit 1
}

valid_iface() {
  [[ "$1" =~ ^[A-Za-z0-9_.:-]+$ ]]
}

valid_cidr() {
  [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$ ]]
}

valid_ipv4() {
  [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]
}

valid_app_dir() {
  [[ "$1" =~ ^/opt/[A-Za-z0-9._/-]+$ ]]
}

valid_share_name() {
  [[ "$1" =~ ^[A-Za-z0-9_-]{3,40}$ ]]
}

valid_drive_path() {
  [[ "$1" =~ ^/[^[:cntrl:]]+$ ]] && [[ "$1" != *".."* ]]
}

service_user() {
  printf '%s' "${TRONSOFTOS_SERVICE_USER:-tronsoftos}"
}

service_group() {
  printf '%s' "${TRONSOFTOS_SERVICE_GROUP:-$(service_user)}"
}

chown_service_account() {
  local recursive="false"
  if [ "${1:-}" = "-R" ]; then
    recursive="true"
    shift
  fi
  local target="$1"
  local user
  local group
  user="$(service_user)"
  group="$(service_group)"
  id "$user" >/dev/null 2>&1 || return 0
  getent group "$group" >/dev/null 2>&1 || group="$user"
  if [ "$recursive" = "true" ]; then
    chown -R "$user:$group" "$target" 2>/dev/null || true
  else
    chown "$user:$group" "$target" 2>/dev/null || true
  fi
}

valid_samba_user() {
  [[ "$1" =~ ^[a-z_][a-z0-9_-]{2,31}$ ]]
}

valid_samba_secret_path() {
  local app_dir="${TRONSOFTOS_APP_DIR:-/opt/tronsoftos}"
  [[ "$1" == "$app_dir"/state/drive-samba-[A-Za-z0-9._-]*/password.secret ]] && [[ "$1" != *".."* ]]
}

env_escape() {
  printf '%s' "$1" | sed 's/[\/&]/\\&/g'
}

set_env_value() {
  local file="$1"
  local key="$2"
  local value="$3"
  local escaped
  escaped="$(env_escape "$value")"
  [ -f "$file" ] || return 0
  if grep -q "^$key=" "$file"; then
    sed -i "s/^$key=.*/$key=$escaped/" "$file"
  else
    printf '\n%s=%s\n' "$key" "$value" >> "$file"
  fi
}

apply_pairing() {
  local app_dir="$1"
  local source_file="$2"
  local tronsoftos_env="/etc/tronsoftos/tronsoftos.env"
  local tronfire_env="$app_dir/apps/tronfire/.env"
  local troncomanda_env="$app_dir/apps/troncomanda/.env"
  local cluster_secrets="$app_dir/state/cluster-secrets.env"
  local ssh_user="${HA_SYNC_SSH_USER:-}"
  local ssh_home=""
  local ssh_dir=""
  local authorized_keys=""
  local ssh_key_imported=false
  local keepalived_applied=false
  local keepalived_result="null"

  valid_app_dir "$app_dir" || fail "Diretorio da aplicacao invalido"
  [[ "$source_file" =~ ^/opt/[A-Za-z0-9._/-]+/state/pairing-import-[A-Za-z0-9._-]+\.env$ ]] || fail "Caminho de pareamento invalido"
  [ -f "$source_file" ] || fail "Arquivo de pareamento nao encontrado"

  # shellcheck disable=SC1090
  . "$source_file"

  [ -n "${SESSION_SECRET:-}" ] || fail "SESSION_SECRET ausente no pareamento"
  [ -n "${TRONSOFTOS_INTERNAL_TOKEN:-}" ] || fail "TRONSOFTOS_INTERNAL_TOKEN ausente no pareamento"
  [ -n "${POSTGRES_PASSWORD:-}" ] || fail "POSTGRES_PASSWORD ausente no pareamento"
  [ -n "${FIREBIRD_PASSWORD:-}" ] || fail "FIREBIRD_PASSWORD ausente no pareamento"
  ssh_user="${HA_SYNC_SSH_USER:-$ssh_user}"

  install -m 0600 "$source_file" "$cluster_secrets"
  chown_service_account "$cluster_secrets"
  set_env_value "$cluster_secrets" "SESSION_SECRET" "$SESSION_SECRET"
  set_env_value "$cluster_secrets" "TRONSOFTOS_INTERNAL_TOKEN" "$TRONSOFTOS_INTERNAL_TOKEN"
  set_env_value "$cluster_secrets" "POSTGRES_PASSWORD" "$POSTGRES_PASSWORD"
  set_env_value "$cluster_secrets" "FIREBIRD_PASSWORD" "$FIREBIRD_PASSWORD"

  set_env_value "$tronsoftos_env" "TRONSOFTOS_INTERNAL_TOKEN" "$TRONSOFTOS_INTERNAL_TOKEN"
  if [ -n "${HA_SYNC_SSH_USER:-}" ]; then
    set_env_value "$tronsoftos_env" "HA_SYNC_SSH_USER" "$HA_SYNC_SSH_USER"
  fi
  if [ -n "${HA_VIP:-}" ]; then
    set_env_value "$tronsoftos_env" "HA_VIP" "$HA_VIP"
  fi
  if [ -n "${HA_VIP_CIDR:-}" ]; then
    set_env_value "$tronsoftos_env" "HA_VIP_CIDR" "$HA_VIP_CIDR"
  fi
  if [ -n "${HA_ROUTER_ID:-}" ]; then
    set_env_value "$tronsoftos_env" "HA_ROUTER_ID" "$HA_ROUTER_ID"
  fi
  if [ -n "${HA_AUTH_PASS:-}" ]; then
    set_env_value "$tronsoftos_env" "HA_AUTH_PASS" "$HA_AUTH_PASS"
  fi
  if [ -n "${HA_PRIMARY_HEALTH_URL:-}" ]; then
    set_env_value "$tronsoftos_env" "HA_PRIMARY_HEALTH_URL" "$HA_PRIMARY_HEALTH_URL"
  fi

  set_env_value "$tronfire_env" "SESSION_SECRET" "$SESSION_SECRET"
  set_env_value "$tronfire_env" "TRONSOFTOS_INTERNAL_TOKEN" "$TRONSOFTOS_INTERNAL_TOKEN"
  set_env_value "$tronfire_env" "FIREBIRD_PASSWORD" "$FIREBIRD_PASSWORD"
  set_env_value "$tronfire_env" "POSTGRES_PASSWORD" "$POSTGRES_PASSWORD"

  cluster_token="$(grep '^TRONSOFTOS_INTERNAL_TOKEN=' "$cluster_secrets" 2>/dev/null | tail -n1 | cut -d= -f2-)"
  tronsoftos_token="$(grep '^TRONSOFTOS_INTERNAL_TOKEN=' "$tronsoftos_env" 2>/dev/null | tail -n1 | cut -d= -f2-)"
  tronfire_token="$(grep '^TRONSOFTOS_INTERNAL_TOKEN=' "$tronfire_env" 2>/dev/null | tail -n1 | cut -d= -f2-)"
  [ "$cluster_token" = "$TRONSOFTOS_INTERNAL_TOKEN" ] || fail "cluster-secrets.env ficou com token interno divergente"
  [ "$tronsoftos_token" = "$TRONSOFTOS_INTERNAL_TOKEN" ] || fail "tronsoftos.env ficou com token interno divergente"
  [ "$tronfire_token" = "$TRONSOFTOS_INTERNAL_TOKEN" ] || fail "TronFire .env ficou com token interno divergente"

  if [ -f "$troncomanda_env" ]; then
    set_env_value "$troncomanda_env" "TRONCOMANDA_FIREBIRD_PASSWORD" "$FIREBIRD_PASSWORD"
  fi

  if [ -n "${TRONSOFTOS_SSH_PUBLIC_KEY:-}" ]; then
    [[ "$TRONSOFTOS_SSH_PUBLIC_KEY" =~ ^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521))[[:space:]][A-Za-z0-9+/=]+([[:space:]][A-Za-z0-9_.@:-]+)?$ ]] || fail "Chave publica SSH invalida"
    ssh_user="${ssh_user:-$(grep '^HA_SYNC_SSH_USER=' "$tronsoftos_env" 2>/dev/null | tail -n1 | cut -d= -f2-)}"
    ssh_user="${ssh_user:-tronsoft}"
    if ! id "$ssh_user" >/dev/null 2>&1; then
      fail "Usuario SSH HA nao existe: $ssh_user"
    fi
    ssh_home="$(getent passwd "$ssh_user" | cut -d: -f6)"
    [ -n "$ssh_home" ] && [ -d "$ssh_home" ] || fail "Home do usuario SSH HA nao encontrado: $ssh_user"
    ssh_dir="$ssh_home/.ssh"
    authorized_keys="$ssh_dir/authorized_keys"
    mkdir -p "$ssh_dir"
    touch "$authorized_keys"
    if ! grep -Fxq "$TRONSOFTOS_SSH_PUBLIC_KEY" "$authorized_keys"; then
      printf '%s\n' "$TRONSOFTOS_SSH_PUBLIC_KEY" >> "$authorized_keys"
    fi
    chown -R "$ssh_user:$ssh_user" "$ssh_dir" 2>/dev/null || true
    chown_service_account -R "$app_dir/state"
    chmod 700 "$ssh_dir"
    chmod 600 "$authorized_keys"
    usermod -aG docker "$ssh_user" 2>/dev/null || true
    ssh_key_imported=true
  fi

  local ha_interface ha_node_role ha_priority
  ha_interface="$(grep '^HA_INTERFACE=' "$tronsoftos_env" 2>/dev/null | tail -n1 | cut -d= -f2- || true)"
  ha_node_role="$(grep '^HA_NODE_ROLE=' "$tronsoftos_env" 2>/dev/null | tail -n1 | cut -d= -f2- || true)"
  ha_priority="$(grep '^HA_PRIORITY=' "$tronsoftos_env" 2>/dev/null | tail -n1 | cut -d= -f2- || true)"
  if [ -n "${HA_VIP_CIDR:-}" ] && [ -n "${HA_ROUTER_ID:-}" ] && [ -n "${HA_AUTH_PASS:-}" ] && [ -n "$ha_interface" ]; then
    keepalived_result="$(apply_vip "$app_dir" "$ha_interface" "$HA_VIP_CIDR" "$HA_ROUTER_ID" "$HA_AUTH_PASS" "${ha_node_role:-BACKUP}" "${ha_priority:-100}")"
    keepalived_applied=true
  fi

  printf '{"ok":true,"clusterSecrets":"%s","tronsoftosEnv":"%s","tronfireEnv":"%s","troncomandaEnvUpdated":%s,"sshKeyImported":%s,"sshUser":"%s","authorizedKeys":"%s","keepalivedApplied":%s,"keepalived":%s}\n' \
    "$(json_escape "$cluster_secrets")" "$(json_escape "$tronsoftos_env")" "$(json_escape "$tronfire_env")" "$([ -f "$troncomanda_env" ] && echo true || echo false)" "$ssh_key_imported" "$(json_escape "${ssh_user:-}")" "$(json_escape "$authorized_keys")" "$keepalived_applied" "$keepalived_result"
}

sync_ip_envs() {
  local app_dir="$1"
  local iface="$2"
  local address_cidr="$3"
  local gateway="$4"
  local dns="$5"
  local server_ip="${address_cidr%%/*}"
  local service_ip="$server_ip"
  local tronsoftos_env="/etc/tronsoftos/tronsoftos.env"
  local tronfire_env="$app_dir/apps/tronfire/.env"
  local troncomanda_env="$app_dir/apps/troncomanda/.env"

  valid_app_dir "$app_dir" || fail "Diretorio da aplicacao invalido"
  if [ -f "$tronsoftos_env" ] && grep -q '^HA_VIP=.\+' "$tronsoftos_env"; then
    service_ip="$(grep '^HA_VIP=' "$tronsoftos_env" | tail -n1 | cut -d= -f2-)"
  fi

  set_env_value "$tronsoftos_env" "HOST_STATIC_IP_ENABLED" "true"
  set_env_value "$tronsoftos_env" "HOST_STATIC_IP_INTERFACE" "$iface"
  set_env_value "$tronsoftos_env" "HOST_STATIC_IP_ADDRESS_CIDR" "$address_cidr"
  set_env_value "$tronsoftos_env" "HOST_STATIC_IP_GATEWAY" "$gateway"
  set_env_value "$tronsoftos_env" "HOST_STATIC_IP_DNS" "\"$dns\""

  if [ -f "$tronsoftos_env" ] && ! grep -q '^HA_VIP=.\+' "$tronsoftos_env"; then
    set_env_value "$tronsoftos_env" "CLOUDFLARE_TARGET_IP" "$server_ip"
  fi

  set_env_value "$tronfire_env" "TRONFIRE_LAN_HOST" "$service_ip"
  local tronsoftos_port="8080"
  if [ -f "$tronsoftos_env" ] && grep -q '^TRONSOFTOS_PORT=' "$tronsoftos_env"; then
    tronsoftos_port="$(grep '^TRONSOFTOS_PORT=' "$tronsoftos_env" | tail -n1 | cut -d= -f2-)"
  fi
  set_env_value "$tronfire_env" "PUBLIC_URL" "http://$service_ip:$tronsoftos_port/tronfire"

  if [ -f "$troncomanda_env" ]; then
    set_env_value "$troncomanda_env" "TRONCOMANDA_LAN_HOST" "$service_ip"
    local troncomanda_port="8000"
    if grep -q '^TRONCOMANDA_WEB_PORT=' "$troncomanda_env"; then
      troncomanda_port="$(grep '^TRONCOMANDA_WEB_PORT=' "$troncomanda_env" | tail -n1 | cut -d= -f2-)"
    fi
    set_env_value "$troncomanda_env" "TRONCOMANDA_PUBLIC_URL" "http://$service_ip:$troncomanda_port"
  fi
}

sync_service_vip_envs() {
  local app_dir="$1"
  local service_ip="$2"
  local tronsoftos_env="/etc/tronsoftos/tronsoftos.env"
  local tronfire_env="$app_dir/apps/tronfire/.env"
  local troncomanda_env="$app_dir/apps/troncomanda/.env"

  valid_app_dir "$app_dir" || fail "Diretorio da aplicacao invalido"
  valid_ipv4 "$service_ip" || fail "VIP invalido"

  set_env_value "$tronsoftos_env" "CLOUDFLARE_TARGET_IP" "$service_ip"

  set_env_value "$tronfire_env" "TRONFIRE_LAN_HOST" "$service_ip"
  local tronsoftos_port="8080"
  if [ -f "$tronsoftos_env" ] && grep -q '^TRONSOFTOS_PORT=' "$tronsoftos_env"; then
    tronsoftos_port="$(grep '^TRONSOFTOS_PORT=' "$tronsoftos_env" | tail -n1 | cut -d= -f2-)"
  fi
  set_env_value "$tronfire_env" "PUBLIC_URL" "http://$service_ip:$tronsoftos_port/tronfire"

  if [ -f "$troncomanda_env" ]; then
    set_env_value "$troncomanda_env" "TRONCOMANDA_LAN_HOST" "$service_ip"
    local troncomanda_port="8000"
    if grep -q '^TRONCOMANDA_WEB_PORT=' "$troncomanda_env"; then
      troncomanda_port="$(grep '^TRONCOMANDA_WEB_PORT=' "$troncomanda_env" | tail -n1 | cut -d= -f2-)"
    fi
    set_env_value "$troncomanda_env" "TRONCOMANDA_PUBLIC_URL" "http://$service_ip:$troncomanda_port"
  fi
}

apply_vip() {
  local app_dir="${1:-}"
  local iface="${2:-}"
  local vip_cidr="${3:-}"
  local router_id="${4:-51}"
  local auth_pass="${5:-}"
  local node_state="${6:-BACKUP}"
  local priority="${7:-100}"

  valid_app_dir "$app_dir" || fail "Diretorio da aplicacao invalido"
  valid_iface "$iface" || fail "Interface invalida"
  valid_cidr "$vip_cidr" || fail "VIP/CIDR invalido"
  [[ "$router_id" =~ ^[0-9]{1,3}$ ]] || fail "Router ID invalido"
  [ "$router_id" -ge 1 ] && [ "$router_id" -le 255 ] || fail "Router ID deve ficar entre 1 e 255"
  [[ "$priority" =~ ^[0-9]{1,3}$ ]] || fail "Prioridade invalida"
  [ "$priority" -ge 1 ] && [ "$priority" -le 254 ] || fail "Prioridade deve ficar entre 1 e 254"
  [[ "$node_state" =~ ^(MASTER|BACKUP)$ ]] || fail "Papel keepalived invalido"
  [[ "$auth_pass" =~ ^[A-Za-z0-9_.:-]{6,32}$ ]] || fail "Senha VRRP invalida; use 6 a 32 caracteres simples"

  local vip="${vip_cidr%%/*}"
  local tronsoftos_env="/etc/tronsoftos/tronsoftos.env"
  local check_source="$app_dir/infra/keepalived/check-tronsoftos.sh"
  local check_target="/etc/keepalived/check-tronsoftos.sh"
  local conf_target="/etc/keepalived/keepalived.conf"

  [ -f "$check_source" ] || fail "check-tronsoftos.sh nao encontrado"
  mkdir -p /etc/keepalived
  install -m 0755 "$check_source" "$check_target"

  cat > "$conf_target" <<EOF
vrrp_script chk_tronsoftos {
    script "$check_target"
    interval 2
    timeout 2
    fall 3
    rise 2
    weight -50
}

vrrp_instance TRONSOFTOS_VIP {
    state $node_state
    interface $iface
    virtual_router_id $router_id
    priority $priority
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass $auth_pass
    }

    virtual_ipaddress {
        $vip_cidr
    }

    track_script {
        chk_tronsoftos
    }
}
EOF

  set_env_value "$tronsoftos_env" "TRONSOFTOS_KEEPALIVED_ENABLED" "true"
  set_env_value "$tronsoftos_env" "HA_INTERFACE" "$iface"
  set_env_value "$tronsoftos_env" "HA_VIP" "$vip"
  set_env_value "$tronsoftos_env" "HA_VIP_CIDR" "$vip_cidr"
  set_env_value "$tronsoftos_env" "HA_ROUTER_ID" "$router_id"
  set_env_value "$tronsoftos_env" "HA_AUTH_PASS" "$auth_pass"
  set_env_value "$tronsoftos_env" "HA_NODE_ROLE" "$node_state"
  set_env_value "$tronsoftos_env" "HA_PRIORITY" "$priority"

  sync_service_vip_envs "$app_dir" "$vip"

  systemctl enable keepalived.service >/dev/null 2>&1 || true
  systemctl restart keepalived.service

  printf '{"ok":true,"interface":"%s","vip":"%s","vipCidr":"%s","routerId":%s,"nodeState":"%s","priority":%s,"config":"%s"}\n' \
    "$(json_escape "$iface")" "$(json_escape "$vip")" "$(json_escape "$vip_cidr")" "$router_id" "$(json_escape "$node_state")" "$priority" "$(json_escape "$conf_target")"
}

apply_static() {
  local iface="${1:-}"
  local address_cidr="${2:-}"
  local gateway="${3:-}"
  local dns="${4:-}"
  local apply_now="${5:-false}"
  local app_dir="${6:-}"

  valid_iface "$iface" || fail "Interface invalida"
  valid_cidr "$address_cidr" || fail "IP/CIDR invalido"
  valid_ipv4 "$gateway" || fail "Gateway invalido"
  [ -n "$dns" ] || fail "DNS nao informado"
  [ -n "$app_dir" ] && sync_ip_envs "$app_dir" "$iface" "$address_cidr" "$gateway" "$dns"

  if command -v nmcli >/dev/null 2>&1; then
    local connection
    connection="$(nmcli -t -f NAME,DEVICE connection show --active | awk -F: -v dev="$iface" '$2==dev {print $1; exit}')"
    if [ -z "$connection" ]; then
      connection="$(nmcli -t -f NAME,DEVICE connection show | awk -F: -v dev="$iface" '$2==dev {print $1; exit}')"
    fi
    [ -n "$connection" ] || fail "Conexao NetworkManager nao encontrada para $iface"

    nmcli connection modify "$connection" \
      ipv4.addresses "$address_cidr" \
      ipv4.gateway "$gateway" \
      ipv4.dns "$dns" \
      ipv4.method manual \
      connection.autoconnect yes

    if [ "$apply_now" = "true" ]; then
      nmcli connection up "$connection"
    fi

    printf '{"ok":true,"backend":"NetworkManager","interface":"%s","connection":"%s","addressCidr":"%s","applied":%s,"envUpdated":true}\n' \
      "$(json_escape "$iface")" "$(json_escape "$connection")" "$(json_escape "$address_cidr")" "$apply_now"
    return 0
  fi

  if systemctl list-unit-files systemd-networkd.service >/dev/null 2>&1; then
    local network_file="/etc/systemd/network/10-tronsoftos-$iface.network"
    {
      echo "[Match]"
      echo "Name=$iface"
      echo
      echo "[Network]"
      echo "DHCP=no"
      echo "Address=$address_cidr"
      echo "Gateway=$gateway"
      for dns_server in $dns; do
        valid_ipv4 "$dns_server" || fail "DNS invalido: $dns_server"
        echo "DNS=$dns_server"
      done
    } > "$network_file"

    systemctl enable systemd-networkd.service >/dev/null 2>&1 || true
    if [ "$apply_now" = "true" ]; then
      systemctl restart systemd-networkd.service
    fi

    printf '{"ok":true,"backend":"systemd-networkd","interface":"%s","networkFile":"%s","addressCidr":"%s","applied":%s,"envUpdated":true}\n' \
      "$(json_escape "$iface")" "$(json_escape "$network_file")" "$(json_escape "$address_cidr")" "$apply_now"
    return 0
  fi

  fail "Nao encontrei NetworkManager nem systemd-networkd"
}

install_firebird_aliases() {
  local source_file="${1:-}"
  [ -f "$source_file" ] || fail "Arquivo de aliases nao encontrado"
  [[ "$source_file" =~ ^/tmp/tronsoftos-aliases-[A-Za-z0-9._-]+\.conf$ ]] || fail "Caminho de aliases invalido"

  local target="/usr/local/firebird/aliases.conf"
  [ -d /usr/local/firebird ] || fail "/usr/local/firebird nao encontrado"
  install -m 0644 "$source_file" "$target"
  if [ -d /opt/firebird ] && [ ! "$target" -ef /opt/firebird/aliases.conf ]; then
    install -m 0644 "$source_file" /opt/firebird/aliases.conf
  fi

  printf '{"ok":true,"target":"%s"}\n' "$(json_escape "$target")"
}

local_keepalived() {
  local action="${1:-}"
  [[ "$action" =~ ^(start|stop|restart)$ ]] || fail "Acao keepalived invalida"
  systemctl "$action" keepalived.service
  local status="unknown"
  status="$(systemctl is-active keepalived.service 2>/dev/null || true)"
  printf '{"ok":true,"service":"keepalived","action":"%s","status":"%s"}\n' "$(json_escape "$action")" "$(json_escape "$status")"
}

set_node_role() {
  local app_dir="${1:-}"
  local role="${2:-}"
  local tronsoftos_env="/etc/tronsoftos/tronsoftos.env"
  local tronfire_env="$app_dir/apps/tronfire/.env"

  valid_app_dir "$app_dir" || fail "Diretorio da aplicacao invalido"
  [[ "$role" =~ ^(primary|standby|recovery)$ ]] || fail "Papel invalido"

  set_env_value "$tronsoftos_env" "TRONSOFTOS_NODE_ROLE" "$role"
  set_env_value "$tronfire_env" "TRONFIRE_NODE_ROLE" "$role"

  if [ "$role" = "primary" ]; then
    set_env_value "$tronsoftos_env" "HA_NODE_ROLE" "MASTER"
    set_env_value "$tronsoftos_env" "HA_PRIORITY" "150"
  elif [ "$role" = "standby" ]; then
    set_env_value "$tronsoftos_env" "HA_NODE_ROLE" "BACKUP"
    set_env_value "$tronsoftos_env" "HA_PRIORITY" "100"
  fi

  printf '{"ok":true,"role":"%s","tronsoftosEnv":"%s","tronfireEnv":"%s"}\n' \
    "$(json_escape "$role")" "$(json_escape "$tronsoftos_env")" "$(json_escape "$tronfire_env")"
}

host_power() {
  local action="${1:-}"
  [[ "$action" =~ ^(reboot|poweroff)$ ]] || fail "Acao de energia invalida"
  if [ "$action" = "reboot" ]; then
    nohup sh -c 'sleep 2; systemctl reboot' >/dev/null 2>&1 &
  else
    nohup sh -c 'sleep 2; systemctl poweroff' >/dev/null 2>&1 &
  fi
  printf '{"ok":true,"action":"%s","scheduled":true,"delaySeconds":2}\n' "$(json_escape "$action")"
}

fix_rclone_permissions() {
  local app_dir="${1:-/opt/tronsoftos}"
  local user
  local group
  valid_app_dir "$app_dir" || fail "Diretorio da aplicacao invalido"
  user="$(service_user)"
  group="$(service_group)"

  if id "$user" >/dev/null 2>&1; then
    getent group "$group" >/dev/null 2>&1 || group="$user"
    install -d -o "$user" -g "$group" -m 0750 "$app_dir/config"
    install -d -o "$user" -g "$group" -m 0700 "$app_dir/config/rclone"
  else
    install -d -m 0750 "$app_dir/config"
    install -d -m 0700 "$app_dir/config/rclone"
  fi
  if [ -f "$app_dir/config/rclone/rclone.conf" ]; then
    chown_service_account "$app_dir/config/rclone/rclone.conf"
    chmod 0600 "$app_dir/config/rclone/rclone.conf"
  fi

  printf '{"ok":true,"path":"%s"}\n' "$(json_escape "$app_dir/config/rclone")"
}

drive_samba_remove_block() {
  local conf="$1"
  [ -f "$conf" ] || return 0
  sed -i '/^# BEGIN TRONSYSTEM DRIVE SHARE$/,/^# END TRONSYSTEM DRIVE SHARE$/d' "$conf"
}

drive_prepare() {
  local share_path="${1:-}"
  valid_drive_path "$share_path" || fail "Caminho do compartilhamento invalido"
  mkdir -p "$share_path" || fail "Nao foi possivel criar a pasta do compartilhamento"
  chown_service_account "$share_path"
  chmod 0770 "$share_path" 2>/dev/null || true
  printf '{"ok":true,"path":"%s"}\n' "$(json_escape "$share_path")"
}

drive_samba() {
  local share_path="${1:-}"
  local share_name="${2:-tronsystem-drive}"
  local auth_mode="${3:-protected}"
  local samba_user="${4:-tronsystem}"
  local password_file="${5:-}"
  local smb_conf="/etc/samba/smb.conf"

  valid_drive_path "$share_path" || fail "Caminho do compartilhamento invalido"
  valid_share_name "$share_name" || fail "Nome do compartilhamento invalido"
  [[ "$auth_mode" == "public" || "$auth_mode" == "protected" ]] || fail "Modo de acesso Samba invalido"
  valid_samba_user "$samba_user" || fail "Usuario Samba invalido"
  [ -d "$share_path" ] || fail "Pasta do compartilhamento nao existe"
  if ! command -v smbd >/dev/null 2>&1 && [ ! -x /usr/sbin/smbd ]; then
    fail "Samba nao instalado; atualize o TronSystem para instalar o pacote samba"
  fi
  if [[ "$auth_mode" == "protected" ]]; then
    command -v smbpasswd >/dev/null 2>&1 || [ -x /usr/bin/smbpasswd ] || fail "smbpasswd nao encontrado; instale samba-common-bin"
    local useradd_bin
    local pdbedit_bin
    useradd_bin="$(command -v useradd || true)"
    useradd_bin="${useradd_bin:-/usr/sbin/useradd}"
    pdbedit_bin="$(command -v pdbedit || true)"
    pdbedit_bin="${pdbedit_bin:-/usr/bin/pdbedit}"
    [ -x "$useradd_bin" ] || fail "useradd nao encontrado"
    [ -x "$pdbedit_bin" ] || fail "pdbedit nao encontrado"
    if ! id "$samba_user" >/dev/null 2>&1; then
      "$useradd_bin" --system --no-create-home --shell /usr/sbin/nologin "$samba_user"
    fi
    if [ -n "$password_file" ]; then
      valid_samba_secret_path "$password_file" || fail "Arquivo de senha Samba invalido"
      [ -f "$password_file" ] || fail "Arquivo de senha Samba nao encontrado"
      local smbpasswd_bin
      smbpasswd_bin="$(command -v smbpasswd || true)"
      smbpasswd_bin="${smbpasswd_bin:-/usr/bin/smbpasswd}"
      {
        cat "$password_file"
        cat "$password_file"
      } | "$smbpasswd_bin" -s -a "$samba_user" >/dev/null
      "$smbpasswd_bin" -e "$samba_user" >/dev/null
    else
      "$pdbedit_bin" -L -u "$samba_user" >/dev/null 2>&1 || fail "Informe a senha para criar o usuario Samba protegido"
    fi
  fi

  install -d -m 0755 /etc/samba
  [ -f "$smb_conf" ] || printf '[global]\n   workgroup = WORKGROUP\n   server role = standalone server\n' > "$smb_conf"
  if [[ "$auth_mode" == "protected" ]]; then
    chown "$samba_user:$samba_user" "$share_path" 2>/dev/null || true
    chmod 0770 "$share_path" 2>/dev/null || true
  else
    chmod 0777 "$share_path" 2>/dev/null || true
  fi

  drive_samba_remove_block "$smb_conf"
  if [[ "$auth_mode" == "protected" ]]; then
    cat >> "$smb_conf" <<EOF
# BEGIN TRONSYSTEM DRIVE SHARE
[global]
   map to guest = Bad User
   usershare allow guests = no

[homes]
   available = no
   browseable = no

[${share_name}]
   path = ${share_path}
   browseable = yes
   read only = no
   guest ok = no
   public = no
   valid users = ${samba_user}
   force user = ${samba_user}
   force group = ${samba_user}
   force create mode = 0660
   force directory mode = 0770
# END TRONSYSTEM DRIVE SHARE
EOF
  else
    cat >> "$smb_conf" <<EOF
# BEGIN TRONSYSTEM DRIVE SHARE
[global]
   map to guest = Bad User
   usershare allow guests = yes

[homes]
   available = no
   browseable = no

[${share_name}]
   path = ${share_path}
   browseable = yes
   read only = no
   guest ok = yes
   public = yes
   force create mode = 0666
   force directory mode = 0777
# END TRONSYSTEM DRIVE SHARE
EOF
  fi

  local testparm_bin
  testparm_bin="$(command -v testparm || true)"
  testparm_bin="${testparm_bin:-/usr/bin/testparm}"
  if [ -x "$testparm_bin" ]; then
    "$testparm_bin" -s "$smb_conf" >/dev/null
  fi
  systemctl enable smbd.service >/dev/null 2>&1 || true
  systemctl restart smbd.service >/dev/null 2>&1 \
    || systemctl restart smbd >/dev/null 2>&1 \
    || service smbd restart >/dev/null 2>&1 \
    || fail "Nao foi possivel reiniciar o servico Samba smbd"
  if systemctl list-unit-files nmbd.service >/dev/null 2>&1; then
    systemctl enable nmbd.service >/dev/null 2>&1 || true
    systemctl restart nmbd.service >/dev/null 2>&1 || true
  fi
  printf '{"ok":true,"shareName":"%s","path":"%s","authMode":"%s","username":"%s"}\n' "$(json_escape "$share_name")" "$(json_escape "$share_path")" "$auth_mode" "$(json_escape "$samba_user")"
}

drive_samba_disable() {
  local smb_conf="/etc/samba/smb.conf"
  drive_samba_remove_block "$smb_conf"
  local testparm_bin
  testparm_bin="$(command -v testparm || true)"
  testparm_bin="${testparm_bin:-/usr/bin/testparm}"
  if [ -x "$testparm_bin" ] && [ -f "$smb_conf" ]; then
    "$testparm_bin" -s "$smb_conf" >/dev/null
  fi
  if systemctl list-unit-files smbd.service >/dev/null 2>&1; then
    systemctl restart smbd.service >/dev/null 2>&1 || true
  fi
  printf '{"ok":true,"disabled":true}\n'
}

firebird_script() {
  local script_path="${1:-}"
  local child_pid=""
  local child_group=false
  local status=0
  [[ "$script_path" =~ ^/tmp/tronsoftos-firebird-[A-Za-z0-9._-]+\.sh$ ]] || fail "Script Firebird invalido"
  [ -f "$script_path" ] || fail "Script Firebird nao encontrado"
  grep -q '^# TronFire host Firebird script$' "$script_path" || fail "Script Firebird sem assinatura esperada"
  chmod 0700 "$script_path"
  cleanup_firebird_script() {
    [ -n "$child_pid" ] || return 0
    if ! kill -0 "$child_pid" >/dev/null 2>&1; then
      return 0
    fi
    if [ "$child_group" = true ]; then
      kill -TERM "-$child_pid" >/dev/null 2>&1 || true
      sleep 2
      kill -KILL "-$child_pid" >/dev/null 2>&1 || true
    else
      kill -TERM "$child_pid" >/dev/null 2>&1 || true
      sleep 2
      kill -KILL "$child_pid" >/dev/null 2>&1 || true
    fi
  }
  trap cleanup_firebird_script INT TERM EXIT
  if command -v setsid >/dev/null 2>&1; then
    TERM=dumb FIREBIRD=/usr/local/firebird LD_LIBRARY_PATH="/usr/local/firebird/lib:${LD_LIBRARY_PATH:-}" setsid bash "$script_path" &
    child_group=true
  else
    TERM=dumb FIREBIRD=/usr/local/firebird LD_LIBRARY_PATH="/usr/local/firebird/lib:${LD_LIBRARY_PATH:-}" bash "$script_path" &
  fi
  child_pid="$!"
  wait "$child_pid" || status="$?"
  child_pid=""
  trap - INT TERM EXIT
  [ "$status" -eq 0 ] || exit "$status"
  printf '{"ok":true,"script":"%s"}\n' "$(json_escape "$script_path")"
}

case "$action" in
  apply-static)
    shift
    apply_static "$@"
    ;;
  install-firebird-aliases)
    shift
    install_firebird_aliases "$@"
    ;;
  apply-pairing)
    shift
    apply_pairing "$@"
    ;;
  apply-vip)
    shift
    apply_vip "$@"
    ;;
  local-keepalived)
    shift
    local_keepalived "$@"
    ;;
  set-node-role)
    shift
    set_node_role "$@"
    ;;
  host-power)
    shift
    host_power "$@"
    ;;
  fix-rclone-permissions)
    shift
    fix_rclone_permissions "$@"
    ;;
  drive-samba)
    shift
    drive_samba "$@"
    ;;
  drive-prepare)
    shift
    drive_prepare "$@"
    ;;
  drive-samba-disable)
    shift
    drive_samba_disable "$@"
    ;;
  firebird-script)
    shift
    firebird_script "$@"
    ;;
  *)
    fail "Acao invalida"
    ;;
esac
