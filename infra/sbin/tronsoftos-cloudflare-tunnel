#!/usr/bin/env bash
set -euo pipefail

default_app_dir() {
  if [ -n "${TRONSOFTOS_APP_DIR:-}" ]; then
    printf '%s\n' "$TRONSOFTOS_APP_DIR"
  elif [ -d /opt/tronos ]; then
    printf '%s\n' /opt/tronos
  elif [ -d /opt/tronsoftos ]; then
    printf '%s\n' /opt/tronsoftos
  else
    printf '%s\n' /opt/tronsoftos
  fi
}

APP_DIR="$(default_app_dir)"
SETTINGS_FILE="${TRONSOFTOS_CLOUDFLARE_SETTINGS:-$APP_DIR/state/cloudflare-settings.json}"
CONTAINER_NAME="${TRONSOFTOS_CLOUDFLARED_CONTAINER:-tronsoftos_cloudflared}"
IMAGE="${TRONSOFTOS_CLOUDFLARED_IMAGE:-cloudflare/cloudflared:latest}"

read_setting() {
  local key="$1"
  node -e '
const fs = require("fs");
const file = process.argv[1];
const key = process.argv[2];
let value = {};
try { value = JSON.parse(fs.readFileSync(file, "utf8")); } catch {}
const out = value[key];
if (out !== undefined && out !== null) process.stdout.write(String(out));
' "$SETTINGS_FILE" "$key"
}

stop_connector() {
  local ids id attempt
  ids="$(docker container ls -aq --filter "name=^/${CONTAINER_NAME}$" || true)"
  [ -n "$ids" ] || return 0

  while IFS= read -r id; do
    [ -n "$id" ] || continue
    docker container update --restart=no "$id" >/dev/null 2>&1 || true
    docker container rm -f "$id" >/dev/null 2>&1 || true

    attempt=1
    while docker container inspect "$id" >/dev/null 2>&1; do
      [ "$attempt" -le 10 ] || {
        echo "Nao foi possivel remover o container Cloudflare existente: $id" >&2
        exit 67
      }
      sleep 1
      docker container rm -f "$id" >/dev/null 2>&1 || true
      attempt=$((attempt + 1))
    done
  done <<EOF
$ids
EOF
}

remove_connector_by_name() {
  local name="$1"
  local ids id
  ids="$(docker container ls -aq --filter "name=^/${name}$" || true)"
  [ -n "$ids" ] || return 0

  while IFS= read -r id; do
    [ -n "$id" ] || continue
    docker container update --restart=no "$id" >/dev/null 2>&1 || true
    docker container rm -f "$id" >/dev/null 2>&1 || true
  done <<EOF
$ids
EOF
}

custom_networks() {
  docker network ls --format '{{.Name}}' | grep -Ev '^(bridge|host|none)$' || true
}

start_candidate_connector() {
  local candidate_name="$1"
  local primary_network="$2"
  local ssh_enabled="$3"
  local token="$4"
  local add_host_status=0
  local run_args=()

  if [ "$ssh_enabled" = "true" ]; then
    run_args=(--add-host host.docker.internal:host-gateway)
  fi

  if [ -n "$primary_network" ]; then
    docker run -d \
      --name "$candidate_name" \
      --restart unless-stopped \
      --network "$primary_network" \
      "${run_args[@]}" \
      -e TUNNEL_TOKEN="$token" \
      "$IMAGE" tunnel --no-autoupdate run >/dev/null || add_host_status=$?
  else
    docker run -d \
      --name "$candidate_name" \
      --restart unless-stopped \
      "${run_args[@]}" \
      -e TUNNEL_TOKEN="$token" \
      "$IMAGE" tunnel --no-autoupdate run >/dev/null || add_host_status=$?
  fi

  if [ "$add_host_status" -ne 0 ] && [ "$ssh_enabled" = "true" ]; then
    echo "Aviso: falha ao iniciar Cloudflare Tunnel com host-gateway; tentando sem host.docker.internal." >&2
    remove_connector_by_name "$candidate_name"
    if [ -n "$primary_network" ]; then
      docker run -d \
        --name "$candidate_name" \
        --restart unless-stopped \
        --network "$primary_network" \
        -e TUNNEL_TOKEN="$token" \
        "$IMAGE" tunnel --no-autoupdate run >/dev/null
    else
      docker run -d \
        --name "$candidate_name" \
        --restart unless-stopped \
        -e TUNNEL_TOKEN="$token" \
        "$IMAGE" tunnel --no-autoupdate run >/dev/null
    fi
  elif [ "$add_host_status" -ne 0 ]; then
    return "$add_host_status"
  fi

  sleep 3
  if [ "$(docker container inspect -f '{{.State.Running}}' "$candidate_name" 2>/dev/null || true)" != "true" ]; then
    echo "Cloudflare Tunnel candidate nao permaneceu em execucao." >&2
    docker logs --tail=80 "$candidate_name" >&2 || true
    remove_connector_by_name "$candidate_name"
    exit 68
  fi
}

apply_connector() {
  local enabled token ssh_enabled networks primary_network network candidate_name
  enabled="$(read_setting enabled)"
  token="$(read_setting tunnelToken)"
  ssh_enabled="$(read_setting maintenanceSshEnabled)"

  if [ "$enabled" != "true" ]; then
    stop_connector
    echo "Cloudflare Tunnel desabilitado; connector parado."
    return 0
  fi

  [ -n "$token" ] || { echo "Token do Cloudflare Tunnel nao configurado." >&2; exit 64; }
  command -v docker >/dev/null 2>&1 || { echo "Docker nao encontrado." >&2; exit 65; }
  docker info >/dev/null 2>&1 || { echo "Docker nao esta acessivel." >&2; exit 66; }

  networks="$(custom_networks)"
  primary_network="$(printf '%s\n' "$networks" | awk 'NF { print; exit }')"
  candidate_name="${CONTAINER_NAME}_candidate_$$"

  remove_connector_by_name "$candidate_name"
  docker image inspect "$IMAGE" >/dev/null 2>&1 || docker pull "$IMAGE"
  start_candidate_connector "$candidate_name" "$primary_network" "$ssh_enabled" "$token"

  while IFS= read -r network; do
    [ -n "$network" ] || continue
    [ "$network" = "$primary_network" ] && continue
    docker network connect "$network" "$candidate_name" >/dev/null 2>&1 || true
  done <<EOF
$networks
EOF

  stop_connector
  docker rename "$candidate_name" "$CONTAINER_NAME"

  if [ "$ssh_enabled" = "true" ]; then
    echo "Cloudflare Tunnel connector iniciado em Docker com acesso ao SSH do host via host.docker.internal:22."
  else
    echo "Cloudflare Tunnel connector iniciado em Docker."
  fi
}

status_connector() {
  docker ps --filter "name=^/${CONTAINER_NAME}$" --format '{{.Names}} {{.Status}} {{.Networks}}' || true
}

case "${1:-apply}" in
  apply)
    apply_connector
    ;;
  stop)
    stop_connector
    echo "Cloudflare Tunnel connector parado."
    ;;
  status)
    status_connector
    ;;
  *)
    echo "Uso: $0 {apply|stop|status}" >&2
    exit 2
    ;;
esac
